# ASR Provider Configuration
# Choose: 'local_whisper', 'elevenlabs', or 'openai'
ASR_PROVIDER=elevenlabs

# Cloud API Keys (Leave blank if using local_whisper)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Premiere Pro MCP Server URL (Defaults to local host port 8000 or stdio)
PREMIERE_MCP_URL=http://localhost:8000
